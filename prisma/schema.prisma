generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum ParsedBy {
  REGEX
  DICTIONARY
  ML
  LLM
}

model User {
  id                    String                 @id @default(uuid())
  email                 String?                @unique
  passwordHash          String?
  telegramId            String?                @unique @db.VarChar(64)
  username              String?
  firstName             String?
  lastName              String?
  profilePhotoUrl       String?
  currency              String                 @default("INR")
  isOnboarded           Boolean                @default(false)
  monthlyIncome         Decimal?               @db.Decimal(12, 2)
  targetSavingsRate     Int                    @default(20)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lastLoginAt           DateTime?
  isActive              Boolean                @default(true)

  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  auditLogs             AuditLog[]
  groupExpenses         GroupExpense[]
  groupSplits           GroupSplit[]

  @@index([telegramId])
  @@index([email])
}

model Category {
  id                    String                 @id @default(uuid())
  userId                String?                // null means system default category
  name                  String
  type                  TransactionType        @default(EXPENSE)
  icon                  String?
  isSystem              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name])
  @@index([name])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  categoryId      String?
  type            TransactionType @default(EXPENSE)
  amount          Decimal         @db.Decimal(12, 2)
  originalAmount  Decimal?        @db.Decimal(12, 2)
  currency        String          @default("INR")
  merchant        String?
  description     String?
  transactionDate DateTime        @default(now())
  splitCount      Int             @default(1)
  rawText         String
  parsedBy        ParsedBy        @default(REGEX)
  isDeleted       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
  @@index([userId, isDeleted])
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  month        Int      // 1-12
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

model RecurringTransaction {
  id             String               @id @default(uuid())
  userId         String
  categoryId     String?
  type           TransactionType      @default(EXPENSE)
  amount         Decimal              @db.Decimal(12, 2)
  description    String?
  cronExpression String
  nextRun        DateTime
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  executions     RecurringExecution[]

  @@index([isActive, nextRun])
}

model RecurringExecution {
  id                     String               @id @default(uuid())
  recurringTransactionId String
  scheduledDate          DateTime
  executedAt             DateTime             @default(now())
  amount                 Decimal              @db.Decimal(12, 2)
  status                 String               @default("SUCCESS")

  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@unique([recurringTransactionId, scheduledDate])
  @@index([scheduledDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. TRANSACTION_CREATED, TRANSACTION_DELETED, BUDGET_UPDATED, RECURRING_CREATED, AUTH_LOGIN, AUTH_REGISTER
  entityType String?  // e.g. TRANSACTION, BUDGET, RECURRING_TRANSACTION, USER, CATEGORY
  entityId   String?  // ID of affected resource
  source     String   @default("SYSTEM") // e.g. WEB, TELEGRAM, SCHEDULER, SYSTEM
  details    Json     // Detailed payload including before/after states, metadata
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model AIPrediction {
  id               String   @id @default(uuid())
  rawPrompt        String
  provider         String
  responseMetadata Json
  tokensUsed       Int      @default(0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())
}

enum UpdateLockStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model TelegramUpdateLock {
  updateId   BigInt           @id
  status     UpdateLockStatus @default(PROCESSING)
  lockedAt   DateTime         @default(now())
  finishedAt DateTime?

  @@index([status, lockedAt])
}

model GroupExpense {
  id             String       @id @default(uuid())
  chatId         String       @db.VarChar(64)
  paidByUserId   String
  totalAmount    Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  description    String
  splitCount     Int          @default(1)
  isSettled      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  paidBy         User         @relation(fields: [paidByUserId], references: [id], onDelete: Cascade)
  splits         GroupSplit[]

  @@index([chatId, isSettled])
}

model GroupSplit {
  id             String       @id @default(uuid())
  groupExpenseId String
  userId         String?
  userName       String
  amountOwed     Decimal      @db.Decimal(12, 2)
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupExpenseId])
}
